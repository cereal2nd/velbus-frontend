#!/bin/sh
# Resolve all frontend dependencies that the application requires to develop.

set -e

cd "$(dirname "$0")/.."

if [ ! -d "./homeassistant-frontend/src" ]; then
  echo "homeassistant-frontend submodule or symlink is missing"
  exit 1
fi

node script/merge_requirements.js
yarn install

# Babel plugins under homeassistant-frontend resolve packages from that tree.
if [ ! -e "./homeassistant-frontend/node_modules" ]; then
  ln -sf "$(pwd)/node_modules" "./homeassistant-frontend/node_modules"
fi
